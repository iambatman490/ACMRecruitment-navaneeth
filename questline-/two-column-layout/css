/* --- Base / Reset Styles --- */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
  padding: 20px;
  /* Default desktop background color */
  background-color: #f4f6f9;
  color: #333333;
  transition: background-color 0.3s ease;
}

.page-header {
  text-align: center;
  margin-bottom: 24px;
}

/* --- Two-Column Layout (CSS Grid) --- */
.container {
  display: grid;
  grid-template-columns: 2fr 1fr; /* 2 columns: main area wider than sidebar */
  gap: 20px;
  max-width: 900px;
  margin: 0 auto;
}

/* Column card styles */
.column {
  background-color: #ffffff;
  padding: 24px;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.column h2 {
  margin-bottom: 12px;
  color: #1a365d;
}

/* --- Media Query: Below 500px --- */
@media screen and (max-width: 499px) {
  /* 1. Change the page's background colour */
  body {
    background-color: #ffe6a7; /* Light amber/yellow */
  }

  /* 2. Stack the columns into a single column on small screens */
  .container {
    grid-template-columns: 1fr;
  }
}
